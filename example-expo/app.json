{
  "expo": {
    "name": "BLE PLX Example",
    "slug": "ble-plx-expo-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bleplxexample",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.iotashan.example.bleplxexpo"
    },
    "android": {
      "package": "com.bleplx.expoexample",
      "adaptiveIcon": {
        "backgroundColor": "#3737DC",
        "foregroundImage": "./assets/images/icon.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "This app uses Bluetooth to communicate with BLE devices.",
          "neverForLocation": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
